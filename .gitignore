# All data files go to karAQI-data repo, not here.
# Exception: weather/seasonality insight images shown on dashboard.
data/*
!data/processed/
data/processed/*
!data/processed/karak_weather_trends_2000_present.png
!data/processed/karak_aqi_open_meteo_seasonality.png

# MLflow file-backed registry (regenerated by the daily training pipeline).
models/mlruns/
mlruns/

# Non-essential model binaries (not used by the deployed dashboard).
models/random_forest_*.joblib
models/lstm_*.keras
models/lstm_*_scaler.joblib
models/xgboost_*.joblib
models/ridge_h*.joblib
models/lstm_h*_target_scaler.joblib

.env

venv*
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
